{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Importação de lançamentos do Ledgr, versão 1",
  "description": "Relatório de lançamentos do sistema de gestão convertido pela IA do usuário (issue #158, ADR-013). Entrada positiva, saída negativa.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "lancamentos"],
  "properties": {
    "versao": { "const": "1" },
    "lancamentos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "valor", "descricao"],
        "properties": {
          "data": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Data do lançamento, AAAA-MM-DD."
          },
          "valor": {
            "type": "string",
            "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
            "description": "Valor com ponto decimal e sinal: entrada positiva, saída negativa. Diferente de zero."
          },
          "descricao": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Histórico do lançamento, numa linha."
          }
        }
      }
    }
  }
}
