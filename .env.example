# preencher quando o Postgres do Railway for criado
DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/ledgr

# segredo compartilhado com o frontend (NextAuth) — ver ADR-003, nunca commitar o valor real
NEXTAUTH_SECRET=

# ADR-002: o MVP não persiste o arquivo bruto do extrato (processa e descarta),
# por isso não existe variável de object storage (S3/R2 etc.) prevista aqui

# IA (issue #28, ADR-011): explicação de divergências via LLM. Nasce
# desligado (LLM_HABILITADO=false) — ligar em produção depende de passos
# fora do código (DPA/Zero Data Retention/teto de gasto no painel da
# OpenAI). Nunca commitar o valor real de OPENAI_API_KEY.
LLM_HABILITADO=false
LLM_PROVEDOR=openai
OPENAI_API_KEY=
OPENAI_MODELO=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SEGUNDOS=20.0
LLM_MAX_TOKENS_SAIDA=300
# Limites de explicações novas por dia (cache não conta), issue #87. Pior caso
# ~US$ 0,00025 por explicação (1.000 tokens de entrada e 300 de saída, Luna a
# US$ 0,10 e US$ 0,50 por milhão): 1.500/dia x 30 dias ~ US$ 11, abaixo do teto
# de US$ 15/mês do projeto na OpenAI, então o limite do backend bate antes.
# Desde a issue #140, por CONTA (todas as empresas clientes somadas).
# LLM_LIMITE_DIARIO_EMPRESA ainda é aceito como nome antigo; com as duas, vale
# esta. O clique e a geração automática gastam os mesmos limites.
LLM_LIMITE_DIARIO_CONTA=300
LLM_LIMITE_DIARIO_GLOBAL=1500
# Geração automática da explicação ao conciliar (issue #140): só gera com
# LLM_HABILITADO também ligado. DESLIGADA EM PRODUÇÃO até os textos novos de
# Privacidade e Termos (front #190 e #197). Ligada, cada POST /conciliacoes
# agenda, depois da resposta, a explicação das divergências do par, as de
# maior valor primeiro, até LLM_TETO_POR_CONCILIACAO explicações novas (cache
# não conta), com LLM_CONCORRENCIA_AUTOMATICA chamadas ao mesmo tempo. Com
# concorrência, o limite diário pode passar por no máximo esse número.
EXPLICACAO_AUTOMATICA_HABILITADA=false
LLM_TETO_POR_CONCILIACAO=100
LLM_CONCORRENCIA_AUTOMATICA=4

# Assistente da Central de ajuda (issue #137, ADR-020): POST /assistente/perguntas
# só responde com ASSISTENTE_HABILITADO e LLM_HABILITADO ligadas; senão, 503.
# Disponível em todos os planos, porque a pergunta não leva dado do cliente.
ASSISTENTE_HABILITADO=false
# O JSON que o front publica no build (front #172). Em produção:
#   AJUDA_CONTEUDO_URL=https://ledgrfinance.com.br/ajuda/conteudo.json
# Vazio, o assistente responde 503. Cache em memória de 10 minutos, mantendo a
# última cópia válida quando a busca falha.
AJUDA_CONTEUDO_URL=
# A Central inteira vai no contexto enquanto o texto couber neste tamanho;
# acima dele, 503 e log de erro (a busca por trecho fica para depois).
ASSISTENTE_MAXIMO_CONTEUDO_CARACTERES=60000
# Perguntas por dia, separadas dos limites das explicações. Uns US$ 0,001 por
# pergunta: 300 por dia dão uns US$ 7 por mês no pior caso, que somados ao pior
# caso das explicações passam do teto de US$ 15 do projeto na OpenAI.
ASSISTENTE_LIMITE_DIARIO_CONTA=100
ASSISTENTE_LIMITE_DIARIO_GLOBAL=300
ASSISTENTE_MAX_TOKENS_SAIDA=500
# O que a descrição do lançamento leva à OpenAI (issue #87): "termos" (padrão)
# só termos bancários (PIX, TED, TARIFA...) e marcadores, o resto vira [TEXTO];
# "mascarada" a descrição com CPF, CNPJ, e-mail, telefone e números mascarados,
# mas com nomes. Use "termos" enquanto não houver Zero Data Retention.
LLM_MODO_DESCRICAO=termos

# E-mail transacional (issue #66, ADR-012): link de aprovação da troca de e-mail e
# de recuperação de senha. Provedor: Resend (API HTTP, sem SDK — mesmo
# padrão da camada de IA do ADR-011). Nasce desligado (EMAIL_HABILITADO=false):
# ligar em produção depende de passos fora do código (domínio verificado
# com SPF/DKIM/DMARC e DPA do provedor, #37). Nunca commitar o valor real
# de RESEND_API_KEY.
EMAIL_HABILITADO=false
EMAIL_PROVEDOR=resend
# chave "Sending access" restrita ao domínio de envio (começa com re_)
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
# o domínio do remetente precisa estar verificado no Resend; não dá pra
# enviar de *.vercel.app
EMAIL_REMETENTE=Ledgr <nao-responda@conta.seudominio.com.br>
# opcional: pra onde vão as respostas (ex.: suporte); vazio = sem Reply-To
EMAIL_RESPONDER_PARA=
EMAIL_TIMEOUT_SEGUNDOS=10.0

# base dos links enviados por e-mail (a página do frontend chama o backend
# com o token). Em produção, o domínio estável do front, com https://:
#   FRONTEND_URL=https://ledgrfinance.com.br
# NUNCA a URL de um deploy (ex.: frontend-hfrnofw9w-ledgr7.vercel.app) nem um
# alias de branch (frontend-git-main-...): a Vercel gera uma URL nova a cada
# deploy do front e aposenta a anterior, então todo link já enviado quebra
# (issue #79). O backend recusa esses valores e o envio fica indisponível, em
# vez de mandar link quebrado. Também não pode ter query string nem fragmento
# (nada de ?a=1 ou #x): o link é montado concatenando o caminho e o fragmento
# do token, então um # aqui sairia com dois # e uma query ficaria no meio do
# caminho. Só esquema, host e, se precisar, caminho (ex.: .../app).
# Em desenvolvimento, http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# --- Rate limit (issue #64) ---
# Segredo que o servidor do Next manda junto com o IP do navegador
# (cabeçalhos X-Ledgr-Segredo-Proxy e X-Ledgr-IP-Cliente). O /login, o
# /register e o /senha/* chegam pela Vercel: sem este segredo, o backend só vê
# o IP da Vercel e o limite dessas rotas vale para todos os usuários juntos.
# Mesmo valor no backend (Railway) e no front (Vercel), gerado com
# `openssl rand -hex 32`. Vazio, o IP repassado é ignorado.
LEDGR_SEGREDO_PROXY=

# --- Login pelo Google (issue #73) ---
# Client id do client OAuth (aplicativo web) da Ledgr no Google Cloud, o mesmo
# que o provider do Google do NextAuth usa na Vercel. O backend confere que o ID
# token do Google foi emitido para ele (claim `aud`). O client id não é segredo;
# o client secret é, e fica só na Vercel: o backend não precisa dele. Vazio, as
# rotas /login/google, /register/google e /convites/aceitar/google respondem
# 503 "Login pelo Google indisponível." sem chamar o Google.
GOOGLE_CLIENT_ID=

# --- Consulta do CNPJ na Receita (issue #119) ---
# O cadastro (/register, /register/google e /register/verificar) confere se o
# CNPJ existe e está ativo, pela BrasilAPI (gratuita, sem chave, dados da base
# aberta da Receita, atualizada por mês). Nasce desligada: sem ela, nada é
# consultado e a empresa é criada como não verificada, como antes. Com ela
# ligada, CNPJ não encontrado ou não ativo dá 422; API fora do ar, lenta (mais
# de 5 s) ou recusando a consulta não bloqueia o cadastro.
CNPJ_CONSULTA_HABILITADA=false
# base da API; o CNPJ, sem máscara, entra no fim do caminho
CNPJ_CONSULTA_URL=https://brasilapi.com.br/api/cnpj/v1
# vazia: a BrasilAPI não usa chave (preenchida, vai como Authorization: Bearer)
CNPJ_CONSULTA_CHAVE=

# --- Plano e período de teste (issue #122) ---
# Ligada, o POST /conciliacoes responde 402 na primeira conciliação de um
# extrato do banco quando a empresa está sem plano ou com o teste de 14 dias
# encerrado. Reconciliar, ler, decidir, exportar, fechar o mês e enviar extrato
# continuam liberados. SÓ LIGAR JUNTO COM AS CHAVES LIVE DA STRIPE: antes delas,
# quem termina o teste não tem como pagar. Os pilotos ficam "ativo" pelo
# scripts/ativar_empresa.py.
PLANO_BLOQUEIO_HABILITADO=false

# --- Aprovação de justificativas (issue #132, ADR-019) ---
# Ligada, toda justificativa nasce aguardando aprovação de admin ou gestor, e o
# mês não fecha com justificativa aguardando aprovação. Desligada (padrão), o
# backend grava a aprovação junto com a justificativa, em nome de quem
# justificou, e o fechamento funciona como antes. LIGAR SÓ DEPOIS DO FRONT que
# aprova: com o front antigo, o mês não fecharia. As rotas de aprovar e
# rejeitar existem nos dois estados, e o analista recebe 403 nelas, e em fechar
# e reabrir, com a flag ligada ou desligada. Ligar não muda o que já foi
# gravado.
APROVACAO_JUSTIFICATIVAS_HABILITADA=false

# --- Link público do relatório do fechamento (issue #165, ADR-024) ---
# Ligada, admin e gestor criam links do relatório de um mês fechado, que
# abrem sem login. Desligada (padrão), criar e consultar dão 404; listar e
# revogar continuam. LIGAR SÓ DEPOIS de a Política de privacidade citar o
# compartilhamento: o relatório traz descrições e nomes de arquivo, que podem
# ter nomes de pessoas.
LINK_PUBLICO_HABILITADO=false

# --- Limites por plano (issue #133, ADR-019) ---
# Quantas empresas clientes e quantos usuários a conta pode ter, por plano.
# Usuários contam os ativos mais os convites pendentes. Inteiros positivos;
# sem valor (ou vazio), não há limite. Os valores ainda não foram decididos:
# até o gateway de pagamento, ficam todos vazios. No limite, POST /empresas e
# POST /empresa/convites respondem 402 para todos, inclusive o admin. Conta sem
# plano usa os limites do essencial. Quem já está acima do limite quando ele é
# ligado ou reduzido não perde nada: só não adiciona mais.
LIMITE_EMPRESAS_ESSENCIAL=
LIMITE_EMPRESAS_PADRAO=
LIMITE_EMPRESAS_AVANCADO=
LIMITE_USUARIOS_ESSENCIAL=
LIMITE_USUARIOS_PADRAO=
LIMITE_USUARIOS_AVANCADO=
# Franquia de conciliações (issues #166 e #167): quantas conciliações por mês
# civil (fuso America/Sao_Paulo) o plano dá à conta, todas as empresas somadas.
# A unidade é a primeira conciliação de cada extrato do banco. Vazio é sem
# limite. Só barra (402) com PLANO_BLOQUEIO_HABILITADO=true.
LIMITE_CONCILIACOES_ESSENCIAL=
LIMITE_CONCILIACOES_PADRAO=
LIMITE_CONCILIACOES_AVANCADO=

# --- Cobrança pela Stripe (issues #166 e #167, ADR-026) ---
# Checkout em modo assinatura (POST /assinatura/checkout) e webhook
# (POST /stripe/webhook), só cartão de crédito. Desligada, ou sem a chave, as
# rotas respondem 503; o boot e os testes não dependem da Stripe. Só use chave de
# TESTE (sk_test_) fora da produção. O webhook é a única fonte de confirmação do
# pagamento.
STRIPE_HABILITADO=false
# Chave secreta da área restrita (sandbox) "Área restrita de Ledgr": sk_test_...
STRIPE_SECRET_KEY=
# Segredo do webhook (whsec_...): o do `stripe listen --forward-to
# localhost:8000/stripe/webhook` no desenvolvimento, ou o do endpoint cadastrado
# no painel da Stripe (eventos: checkout.session.completed,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed).
STRIPE_WEBHOOK_SECRET=
# Chave live (sk_live_, rk_live_) derruba o boot sem esta variável em true. Só
# ligue junto com PLANO_BLOQUEIO_HABILITADO=true, depois que a Política de
# privacidade citar a Stripe.
STRIPE_MODO_LIVE=false

# --- Logs (issue #102) ---
# Nível do logger `app` (stderr, com data, nível e módulo): DEBUG, INFO,
# WARNING, ERROR ou CRITICAL. Não muda os logs do uvicorn. Regra da issue #34:
# nenhum log de app/ imprime e-mail, nome, descrição de lançamento, token ou link.
LOG_LEVEL=INFO

# --- Documentação da API (issue #102) ---
# /docs, /redoc e /openapi.json. Ligado em desenvolvimento; em produção (Railway),
# API_DOCS_HABILITADO=false: as três rotas respondem 404.
API_DOCS_HABILITADO=true

# --- Conexão MCP (issue #136, ADR-022) ---
# O Ledgr como servidor de autorização OAuth do ChatGPT e do Claude do cliente.
# Desligada, /.well-known/oauth-*, /oauth/*, /conexoes-mcp/* e /mcp respondem
# 404. Fica desligada em produção até a Política de privacidade dizer que o
# dado sai para a conta de IA do cliente.
MCP_HABILITADO=false
# A URL canônica do servidor MCP, sem barra no fim, e a base do servidor de
# autorização. Ligada sem as duas, as rotas respondem 503. Use um domínio
# próprio antes de ligar: trocar a URL derruba todas as conexões.
#   MCP_URL_PUBLICA=https://api.ledgrfinance.com.br/mcp
#   OAUTH_ISSUER=https://api.ledgrfinance.com.br
MCP_URL_PUBLICA=
OAUTH_ISSUER=
# redirect_uris aceitos no registro de cliente, separados por vírgula. Vazio
# vale a lista do código (Claude, ChatGPT e loopback do Claude Code). `*` vale
# um segmento de caminho; http://localhost e http://127.0.0.1 em qualquer porta.
OAUTH_REDIRECTS_PERMITIDOS=

# --- Arquivo original do extrato (issue #139, ADR-023) ---
# Ligada, as contas do plano avançado guardam o arquivo de cada extrato, cifrado,
# no bucket próprio do R2 (não o dos backups), e o admin e o gestor baixam o
# original. Desligada até o retorno jurídico e o texto da Política de
# privacidade. Ligada sem as cinco variáveis abaixo, nada é guardado e o
# download responde 503.
ARQUIVO_ORIGINAL_HABILITADO=false
# https://<account_id>.r2.cloudflarestorage.com, sem o nome do bucket no fim.
ARQUIVO_ORIGINAL_R2_ENDPOINT=
ARQUIVO_ORIGINAL_R2_BUCKET=
# Token "Object Read & Write" restrito ao bucket acima.
ARQUIVO_ORIGINAL_R2_ACCESS_KEY_ID=
ARQUIVO_ORIGINAL_R2_SECRET_ACCESS_KEY=
# Chave do AES-256-GCM, 32 bytes em base64: `openssl rand -base64 32`. Fica no
# Railway e nos gerenciadores de senhas do Vitor e do Rafael; perdê-la é perder
# todos os arquivos guardados.
ARQUIVO_ORIGINAL_CHAVE=
