# preencher quando o Postgres do Railway for criado
DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/ledgr

# segredo compartilhado com o frontend (NextAuth) — ver ADR-003, nunca commitar o valor real
NEXTAUTH_SECRET=

# ADR-002: o MVP não persiste o arquivo bruto do extrato (processa e descarta),
# por isso não existe variável de object storage (S3/R2 etc.) prevista aqui
