# preencher quando o Postgres do Railway for criado
DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/ledgr

# segredo compartilhado com o frontend (NextAuth) — ver ADR-003, nunca commitar o valor real
NEXTAUTH_SECRET=

# ADR-002: o MVP não persiste o arquivo bruto do extrato (processa e descarta),
# por isso não existe variável de object storage (S3/R2 etc.) prevista aqui

# IA (issue #28, ADR-011): explicação de divergências via LLM. Nasce
# desligado (LLM_HABILITADO=false) — ligar em produção depende de passos
# fora do código (DPA/Zero Data Retention/teto de gasto no painel da
# OpenAI). Nunca commitar o valor real de OPENAI_API_KEY.
LLM_HABILITADO=false
LLM_PROVEDOR=openai
OPENAI_API_KEY=
OPENAI_MODELO=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SEGUNDOS=20.0
LLM_MAX_TOKENS_SAIDA=300
LLM_LIMITE_DIARIO_EMPRESA=50
LLM_LIMITE_DIARIO_GLOBAL=300

# E-mail transacional (issue #66, ADR-012): link de aprovação da troca de e-mail e
# de recuperação de senha. Provedor: Resend (API HTTP, sem SDK — mesmo
# padrão da camada de IA do ADR-011). Nasce desligado (EMAIL_HABILITADO=false):
# ligar em produção depende de passos fora do código (domínio verificado
# com SPF/DKIM/DMARC e DPA do provedor, #37). Nunca commitar o valor real
# de RESEND_API_KEY.
EMAIL_HABILITADO=false
EMAIL_PROVEDOR=resend
# chave "Sending access" restrita ao domínio de envio (começa com re_)
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
# o domínio do remetente precisa estar verificado no Resend; não dá pra
# enviar de *.vercel.app
EMAIL_REMETENTE=Ledgr <nao-responda@conta.seudominio.com.br>
# opcional: pra onde vão as respostas (ex.: suporte); vazio = sem Reply-To
EMAIL_RESPONDER_PARA=
EMAIL_TIMEOUT_SEGUNDOS=10.0

# base dos links enviados por e-mail (a página do frontend chama o backend
# com o token). Em produção, o domínio estável do front, com https://:
#   FRONTEND_URL=https://ledgrfinance.com.br
# NUNCA a URL de um deploy (ex.: frontend-hfrnofw9w-ledgr7.vercel.app) nem um
# alias de branch (frontend-git-main-...): a Vercel gera uma URL nova a cada
# deploy do front e aposenta a anterior, então todo link já enviado quebra
# (issue #79). O backend recusa esses valores e o envio fica indisponível, em
# vez de mandar link quebrado. Também não pode ter query string nem fragmento
# (nada de ?a=1 ou #x): o link é montado concatenando o caminho e o fragmento
# do token, então um # aqui sairia com dois # e uma query ficaria no meio do
# caminho. Só esquema, host e, se precisar, caminho (ex.: .../app).
# Em desenvolvimento, http://localhost:3000.
FRONTEND_URL=http://localhost:3000

# --- Rate limit (issue #64) ---
# Segredo que o servidor do Next manda junto com o IP do navegador
# (cabeçalhos X-Ledgr-Segredo-Proxy e X-Ledgr-IP-Cliente). O /login, o
# /register e o /senha/* chegam pela Vercel: sem este segredo, o backend só vê
# o IP da Vercel e o limite dessas rotas vale para todos os usuários juntos.
# Mesmo valor no backend (Railway) e no front (Vercel), gerado com
# `openssl rand -hex 32`. Vazio, o IP repassado é ignorado.
LEDGR_SEGREDO_PROXY=

# --- Logs (issue #102) ---
# Nível do logger `app` (stderr, com data, nível e módulo): DEBUG, INFO,
# WARNING, ERROR ou CRITICAL. Não muda os logs do uvicorn. Regra da issue #34:
# nenhum log de app/ imprime e-mail, nome, descrição de lançamento, token ou link.
LOG_LEVEL=INFO

# --- Documentação da API (issue #102) ---
# /docs, /redoc e /openapi.json. Ligado em desenvolvimento; em produção (Railway),
# API_DOCS_HABILITADO=false: as três rotas respondem 404.
API_DOCS_HABILITADO=true
